<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ToDo_csharp.MainWindow"
        Title="ToDo-List">
    

        <StackPanel>
                <UserControl Padding="20" HorizontalAlignment="Center">
                        <Button Click="CreatingNewList">
                                Nova Lista
                        </Button>
                </UserControl>

                <Grid x:Name="ContainerListas" RowDefinitions="Auto, *">
                        <StackPanel x:Name="Listas" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Tag="0">

                        </StackPanel>
                </Grid>
        </StackPanel>
</Window>
