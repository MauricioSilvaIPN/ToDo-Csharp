<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ToDo_csharp.MainWindow"
        Title="ToDo_csharp">
    

        <StackPanel>
                <UserControl Padding="20" HorizontalAlignment="Center">
                        <Button Click="CreatingNewList">
                                New List
                        </Button>
                </UserControl>

                <Grid x:Name="Listas" ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" Margin="0,0,10,0" Background="Transparent">
                                <Image Source="avares://ToDo-csharp/images/checkbox.png" Width="20" Height="20" />
                        </Button>
                        
                        <TextBox PlaceholderText="Digite sua tarefa aqui" Grid.Column="1" Width="450"></TextBox>
                        
                        <Button Grid.Column="2" Margin="10,0,0,0">
                                Delete
                        </Button>
                </Grid>
        </StackPanel>
</Window>
